# lib/db.js
TS_DB_URL=                 # postgres connection string (migrations, health probe)
TS_SUPABASE_URL=
TS_SUPABASE_ANON_KEY=
TS_SUPABASE_SERVICE_KEY=   # service role — never sent to a browser
TS_JWT_SECRET=             # the project's JWT signing secret; mints tenant-scoped anon tokens
# lib/email.js
TS_EMAIL_API_KEY=
TS_EMAIL_FROM=
TS_EMAIL_API_URL=          # optional; defaults to the PROVISIONAL provider (D19)
# lib/platform.js (non-secret)
TS_DEFAULT_HOST=           # host of the platform landing page
TS_PUBLIC_BASE_SCHEME=https
# server.js
PORT=3000
NODE_ENV=production
