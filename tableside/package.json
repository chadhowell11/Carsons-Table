{
  "name": "tableside",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant restaurant platform (working name PROVISIONAL, see lib/platform.js)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.dev-stack/env server.js",
    "migrate": "node scripts/migrate.js",
    "seed:dev": "node --env-file=.dev-stack/env scripts/seed-dev.js",
    "stack:start": "bash scripts/dev-stack/start.sh",
    "stack:stop": "bash scripts/dev-stack/stop.sh",
    "test": "node scripts/run-tests.js unit static",
    "test:unit": "node scripts/run-tests.js unit",
    "test:static": "node scripts/run-tests.js static",
    "test:db": "node scripts/run-tests.js db",
    "test:probes": "node scripts/run-tests.js probes"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
